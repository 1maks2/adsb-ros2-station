<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aircraft_tracker</name>
  <version>0.1.0</version>
  <description>Węzły ROS 2 przenośnej stacji ADS-B: odbiór ramek z dump1090, dekodowanie pozycji statków powietrznych, odczyt GPS, monitorowanie zasilania i wyświetlacz TFT.</description>
  <maintainer email="maksstach11@gmail.com">Maks</maintainer>
  <license>MIT</license>

  <!-- Własna wiadomość AircraftState - musi zostać zbudowana wcześniej -->
  <depend>aircraft_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>